{
  "name": "jgames",
  "version": "1.0.0",
  "description": "API-first game event management platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "create:admin": "tsx src/scripts/create-admin.ts",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server.js",
    "perf:test": "tsx src/scripts/load-test.ts",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeetesh10/JGames.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jeetesh10/JGames/issues"
  },
  "homepage": "https://github.com/jeetesh10/JGames#readme",
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.8.0",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
